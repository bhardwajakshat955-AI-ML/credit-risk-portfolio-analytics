        X2[Aggregate to join grain:<br/>bureau → customer · repayment → account<br/>collections → account]
        X3[Join to loan grain<br/>row-count asserted at every step]
    end

    subgraph ANA["4. Analytics & model training"]
        direction TB
        A1[Portfolio profiling · cross-cuts<br/>vintage trends · 5 insights<br/>src/analytics.py · matplotlib]
        A2[Customer-grouped split + OOT check<br/>Logistic regression · LightGBM<br/>AUC / KS / Gini · SHAP<br/>src/modeling.py · scikit-learn · lightgbm · shap]
    end

    subgraph STO["5. Scoring & storage (local files)"]
        direction TB
        S1[(data/processed/<br/>loan_level_dataset.parquet<br/>scored_loans.parquet<br/>shap_values.parquet)]
        S2[(models/<br/>lightgbm.joblib<br/>logistic_regression.joblib<br/>model_metadata.json)]
        S3[(reports/<br/>data quality · findings<br/>model evaluation · assumptions)]
    end

    subgraph DSH["6. Interactive dashboard<br/>app/dashboard.py · Streamlit · Plotly"]
        direction TB
        D1[Portfolio view<br/>KPIs · risk segments · dimensions<br/>trends · cross-cut · insights]
        D2[Account view<br/>PD estimate · risk segment<br/>SHAP drivers · repayment · bureau]
        D3[Sidebar filters<br/>region · income · employment<br/>loan type · risk segment]
    end

    subgraph AI["7. Embedded AI feature<br/>src/anomaly.py · rule engine"]
