        B[bureau_credit.csv<br/>22,979 rows]
        R[repayment_history.csv<br/>176,220 rows]
        K[collections_events.csv<br/>8,635 rows]
    end

    subgraph ING["2. Ingestion & validation<br/>src/ingestion.py · pandas"]
        direction TB
        I1[Load + parse dates]
        I2[PK uniqueness · FK integrity<br/>coverage checks]
    end

